{
  "name": "lodestar",
  "version": "0.1.0",
  "description": "宿星 · 把记忆封存成一颗星",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron . --dev",
    "app": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "launch": "powershell -ExecutionPolicy Bypass -File \"./启动宿星.ps1\""
  },
  "dependencies": {
    "three": "^0.172.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true
  }
}
